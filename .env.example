# Autenticação
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
# Origem pública canônica (HTTPS) usada para montar o redirect de login sem
# confiar no Host enviado pelo cliente, ex.: https://dashboard.joaosouzacoder.com.br
PUBLIC_ORIGIN=

# Contas de e-mail/agenda (himalaya usa os ids "work"/"personal" configurados nele)
WORK_CALENDAR_EMAIL=
PERSONAL_CALENDAR_EMAIL=

# Jira
JIRA_CLOUD=
JIRA_EMAIL=
JIRA_TOKEN=

# GitHub (ghpending)
GITHUB_TOKEN=

# Microsoft To Do
DAILY_TUI_TODO_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
DAILY_TUI_TODO_LIST=

# Pomodoro
POMODORO_ENABLED=true
POMODORO_FOCUS_MINUTES=25
POMODORO_REST_MINUTES=5
NTFY_TOPIC=

# Atualização em segundo plano
REFRESH_SECONDS=300

# Banco local (SQLite)
DAILY_WEB_DB_PATH=/home/jgabr/projects/daily-web/data/daily-web.db
