# Autenticação
# DASHBOARD_USER/DASHBOARD_PASSWORD_HASH são apenas a semente do primeiro
# admin, usada na primeira subida quando a tabela de usuários está vazia.
# Depois disso os usuários vivem no banco — use `npm run users`.
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
# Origem pública canônica (HTTPS) usada para montar o redirect de login sem
# confiar no Host enviado pelo cliente, ex.: https://dashboard.exemplo.com
PUBLIC_ORIGIN=

# Contas de e-mail/agenda (himalaya usa os ids "work"/"personal" configurados nele)
WORK_CALENDAR_EMAIL=
PERSONAL_CALENDAR_EMAIL=

# Jira
JIRA_CLOUD=
JIRA_EMAIL=
JIRA_TOKEN=

# GitHub (ghpending)
GITHUB_TOKEN=

# Microsoft To Do
# Registre um app próprio no Azure (Entra ID > App registrations, tipo "public
# client") e use o Application (client) ID dele aqui. Não use o client ID do
# "Microsoft Graph Command Line Tools": ele é um app first-party da Microsoft,
# e administradores de tenant podem bloqueá-lo a qualquer momento.
DAILY_TUI_TODO_CLIENT_ID=
DAILY_TUI_TODO_LIST=

# Pomodoro
POMODORO_ENABLED=true
POMODORO_FOCUS_MINUTES=25
POMODORO_REST_MINUTES=5
NTFY_TOPIC=

# Rascunho de resposta com IA (Claude)
ANTHROPIC_API_KEY=

# Atualização em segundo plano
REFRESH_SECONDS=300

# Banco local (SQLite)
DAILY_WEB_DB_PATH=./data/daily-web.db
